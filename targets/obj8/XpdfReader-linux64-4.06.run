/bin/echo ""
/bin/echo -n "Type 'yes' to accept the license: "
read ok
if [ "x$ok" != "xyes" ]; then
  exit 1
fi

/bin/echo ""
/bin/echo -n "Install directory: "
read dir

eval dir=$dir
if [ "x$dir" = "x" ]; then
  dir="."
fi

if [ -e "$dir/$name" ]; then
  /bin/echo "Directory '$dir/$name' already exists - aborting"
  exit 1
fi

/bin/echo "Unpacking files into $dir/$name..."
/bin/echo -n "Press enter to start: "
read ok

mkdir -p "$dir"

(dd bs=1024 skip=$skip1 count=$count1 if=$0 2>/dev/null; dd bs=1 skip=$skip2 count=$count2 if=$0 2>/dev/null) | tar -C "$dir" -xzf -

/bin/echo ""
/bin/echo "The XpdfReader executable is $dir/$name/xpdf"

exit 0
